----------------------------------------------------------------------
-- KILL AURA / ALCANCE DA ESPADA  (embutida e corrigida)
--
-- O que foi corrigido em relação à versão antiga:
--  * Loop em Heartbeat (RenderStepped para de rodar com a janela minimizada/sem foco)
--  * Watchdog: se o loop morrer por qualquer motivo, ele é religado sozinho
--  * Cada ciclo roda dentro de pcall: um erro não derruba mais o loop inteiro
--  * Teleporte de volta SEMPRE acontece (antes um erro deixava você preso no inimigo)
--  * Intervalo entre ataques (antes spammava firetouchinterest todo frame, o que
--    estoura o limite de eventos e pode ser ignorado/derrubado pelo servidor)
--  * Escolha da parte da espada: usa a parte que tem TouchInterest (hitbox real),
--    revalida se ela sumir/trocar, e não pega mais uma "Part" qualquer
--  * Auto-golpe (Tool:Activate) — muitos servidores só contam o dano durante o swing
--  * Atinge várias partes do inimigo (raiz, cabeça, tronco) e vários alvos por ciclo
--  * Pula inimigos mortos, com ForceField ou do seu time (opcional)
--  * Equipar espada automático ao respawnar (opcional)
--  * Recarregar o script limpa a instância antiga (antes empilhava loops)
--  * Painel de status para você ver exatamente onde ela para (se parar)
----------------------------------------------------------------------
local KA = {
	Enabled = false, Range = 18, Teleport = true, AutoSwing = true, TeamCheck = true,
	MaxTargets = 4, Interval = 0.06, Highlight = true, AutoEquip = false, Priority = "Mais perto",
	Hits = 0, LastHit = 0, Targets = 0, Errors = 0, Restarts = 0, LastErr = "-", Status = "desligada",
	IgnoreFF = false, Reach = false, ReachSize = 12, Nearest = nil, ToolName = "-", PartInfo = "-",
}
local reachOrig = {}
local function reachRestore()
	for p, o in pairs(reachOrig) do
		if p.Parent then pcall(function() p.Size, p.Massless, p.CanCollide = o[1], o[2], o[3] end) end
		reachOrig[p] = nil
	end
end
local function reachStep()
	local ch = LP.Character
	local tool = ch and ch:FindFirstChildOfClass("Tool")
	if not KA.Reach or not tool then reachRestore() return end
	local h = tool:FindFirstChild("Handle")
	if not (h and h:IsA("BasePart")) then return end
	for p in pairs(reachOrig) do if p ~= h then reachRestore() break end end
	if not reachOrig[h] then reachOrig[h] = { h.Size, h.Massless, h.CanCollide } end
	pcall(function()
		h.Size = Vector3.new(KA.ReachSize, KA.ReachSize, KA.ReachSize)
		h.Massless = true
		h.CanCollide = false
	end)
end
local ftouch = firetouchinterest
local partCache = { tool = nil, parts = {}, t = 0 }
local indicator, hue = nil, 0
local lastTick, lastAttack, lastSwing, lastEquip = os.clock(), 0, 0, 0

local function killIndicator()
	if indicator then pcall(function() indicator:Destroy() end) indicator = nil end
end

local function getToolParts(tool)
	local now = os.clock()
	if partCache.tool == tool and now - partCache.t < 1 and #partCache.parts > 0 then
		local ok = true
		for _, p in ipairs(partCache.parts) do if not p.Parent then ok = false break end end
		if ok then return partCache.parts end
	end
	local all, touchy = {}, {}
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("BasePart") then
			all[#all + 1] = d
			if d:FindFirstChildWhichIsA("TouchTransmitter") then touchy[#touchy + 1] = d end
		end
	end
	local use = touchy
	if #use == 0 then
		local h = tool:FindFirstChild("Handle") or tool:FindFirstChild("Blade")
		if h and h:IsA("BasePart") then use = { h } else use = all end
	end
	while #use > 3 do table.remove(use) end
	partCache = { tool = tool, parts = use, t = now }
	return use
end

local function isEnemy(plr)
	if plr == LP then return false end
	if KA.TeamCheck and plr.Team ~= nil and LP.Team ~= nil and plr.Team == LP.Team then return false end
	return true
end

local function collectTargets(myRoot)
	local list = {}
	local myPos = myRoot.Position
	KA.Nearest = nil
	for _, plr in ipairs(Players:GetPlayers()) do
		if isEnemy(plr) then
			local ch = plr.Character
			local r = ch and ch:FindFirstChild("HumanoidRootPart")
			local h = ch and ch:FindFirstChildOfClass("Humanoid")
			if r and h and h.Health > 0 and (KA.IgnoreFF or not ch:FindFirstChildOfClass("ForceField")) then
				local d = (myPos - r.Position).Magnitude
				if not KA.Nearest or d < KA.Nearest then KA.Nearest = d end
				if d <= KA.Range then
					list[#list + 1] = { ch = ch, root = r, hum = h, dist = d }
				end
			end
		end
	end
	if KA.Priority == "Menos vida" then
		table.sort(list, function(a, b) return a.hum.Health < b.hum.Health end)
	else
		table.sort(list, function(a, b) return a.dist < b.dist end)
	end
	while #list > KA.MaxTargets do table.remove(list) end
	return list
end

local function hitTarget(parts, tgt, myRoot)
	local targetParts = { tgt.root }
	local head = tgt.ch:FindFirstChild("Head")
	if head then targetParts[#targetParts + 1] = head end
	local torso = tgt.ch:FindFirstChild("UpperTorso") or tgt.ch:FindFirstChild("Torso")
	if torso then targetParts[#targetParts + 1] = torso end

	local origin = myRoot.CFrame
	local moved = false
	if KA.Teleport then
		moved = pcall(function() myRoot.CFrame = tgt.root.CFrame * CFrame.new(0, 0, 2) end)
	end
	local ok, err = pcall(function()
		for _, sp in ipairs(parts) do
			for _, tp in ipairs(targetParts) do
				ftouch(sp, tp, 0)
				ftouch(sp, tp, 1)
			end
		end
	end)
	if moved then pcall(function() myRoot.CFrame = origin end) end -- volta SEMPRE
	if not ok then
		KA.Errors = KA.Errors + 1
		KA.LastErr = tostring(err):sub(1, 60)
	else
		KA.Hits = KA.Hits + 1
		KA.LastHit = os.clock()
	end
end

local function kaStep()
	local ch = LP.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hum or not myRoot or hum.Health <= 0 then KA.Status = "aguardando respawn" killIndicator() return end

	local tool = ch:FindFirstChildOfClass("Tool")
	if not tool then
		killIndicator()
		KA.Status = "sem espada equipada"
		if KA.AutoEquip and os.clock() - lastEquip > 1 then
			lastEquip = os.clock()
			local bp = LP:FindFirstChildOfClass("Backpack")
			local t = bp and bp:FindFirstChildOfClass("Tool")
			if t then pcall(function() hum:EquipTool(t) end) end
		end
		return
	end

	KA.ToolName = tool.Name
	local parts = getToolParts(tool)
	local names = {}
	for _, p in ipairs(parts) do names[#names + 1] = p.Name end
	KA.PartInfo = table.concat(names, ", ")
	if #parts == 0 then KA.Status = "espada sem hitbox" killIndicator() return end
	if not ftouch then KA.Status = "ERRO: executor sem firetouchinterest" return end

	if KA.Highlight then
		if not indicator or indicator.Adornee ~= parts[1] or not indicator.Parent then
			killIndicator()
			pcall(function()
				indicator = Instance.new("SelectionBox")
				indicator.Adornee = parts[1]
				indicator.LineThickness = 0.03
				indicator.Parent = parts[1]
			end)
		end
		if indicator then
			hue = (hue + 0.012) % 1
			indicator.Color3 = Color3.fromHSV(hue, 1, 1)
		end
	else
		killIndicator()
	end

	local targets = collectTargets(myRoot)
	KA.Targets = #targets
	if #targets == 0 then KA.Status = "ligada — sem alvos no alcance" return end
	KA.Status = "atacando"

	if KA.AutoSwing and os.clock() - lastSwing > 0.25 then
		lastSwing = os.clock()
		pcall(function() tool:Activate() end)
	end
	for _, tgt in ipairs(targets) do hitTarget(parts, tgt, myRoot) end
end

local kaConn
local function kaOnHeartbeat()
	lastTick = os.clock()
	if alive and KA.Reach and lastTick - (KA.lastReach or 0) > 0.2 then
		KA.lastReach = lastTick
		pcall(reachStep)
	end
	if not KA.Enabled or not alive then return end
	if lastTick - lastAttack < KA.Interval then return end
	lastAttack = lastTick
	local ok, err = pcall(kaStep)
	if not ok then
		KA.Errors = KA.Errors + 1
		KA.LastErr = tostring(err):sub(1, 60)
	end
end
local function kaConnect()
	if kaConn then pcall(function() kaConn:Disconnect() end) end
	kaConn = RunService.Heartbeat:Connect(kaOnHeartbeat)
	lastTick = os.clock()
end
kaConnect()
onCleanup(function() KA.Enabled = false KA.Reach = false reachRestore() if kaConn then kaConn:Disconnect() end killIndicator() end)

-- watchdog: religa o loop se ele parar de rodar
task.spawn(function()
	while alive do
		task.wait(1)
		if os.clock() - lastTick > 2 then
			KA.Restarts = KA.Restarts + 1
			kaConnect()
		end
	end
end)

