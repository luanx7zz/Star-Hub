			function obj:Set(v, silent) obj.Value = v paintValue() render() if not silent then safe(dcfg.Callback, v) end end
			function obj:Refresh(newOpts, keep)
				opts = newOpts or {}
				if not keep then obj.Value = nil end
				paintValue()
				render()
			end
			paintValue()
			render()
			return obj
		end

		return Tab
	end

	function Window:SelectFirst() if tabs[1] then selectTab(tabs[1]) end end
	return Window
