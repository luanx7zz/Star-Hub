local S = {
	InfJump = false, Fly = false, FlySpeed = 60, JumpOn = false, JumpPower = 90, Bhop = false,
	AntiVoid = false, AntiRagdoll = false, Fullbright = false, NoFog = false, FovOn = false, Fov = 90,
	Zoom = false, AntiAFK = true,
}
local flyBV, flyBG
local safePos, lastSafe = nil, 0
local lightOrig, zoomOrig, atmoOrig = nil, nil, {}

local function flyCleanup()
	if flyBV then pcall(function() flyBV:Destroy() end) flyBV = nil end
	if flyBG then pcall(function() flyBG:Destroy() end) flyBG = nil end
	local h = getHum()
	if h then pcall(function() h.PlatformStand = false end) end
end

local function flyStep()
	local r, h = getRoot(), getHum()
	if not r or not h then return end
	if not flyBV or flyBV.Parent ~= r then
		if flyBV then flyBV:Destroy() end
		if flyBG then flyBG:Destroy() end
		flyBV = Instance.new("BodyVelocity")
		flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		flyBV.Velocity = Vector3.zero
		flyBV.Parent = r
		flyBG = Instance.new("BodyGyro")
		flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		flyBG.P = 9e4
		flyBG.CFrame = r.CFrame
		flyBG.Parent = r
	end
	h.PlatformStand = true
	local c = cam().CFrame
	local look = Vector3.new(c.LookVector.X, 0, c.LookVector.Z)
	local right = Vector3.new(c.RightVector.X, 0, c.RightVector.Z)
	local m = h.MoveDirection
	local dir = Vector3.zero
	if look.Magnitude > 0.01 and right.Magnitude > 0.01 then
		dir = c.LookVector * m:Dot(look.Unit) + c.RightVector * m:Dot(right.Unit)
	end
	local up = 0
	if UIS:IsKeyDown(Enum.KeyCode.Space) then up = 1
	elseif UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then up = -1 end
	flyBV.Velocity = dir * S.FlySpeed + Vector3.new(0, up * S.FlySpeed, 0)
	flyBG.CFrame = c
end

local function applyAntiRagdoll(on)
	local h = getHum()
	if not h then return end
	for _, st in ipairs({ Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.PlatformStanding }) do
		pcall(function() h:SetStateEnabled(st, not on) end)
	end
end

local function saveLighting()
	if lightOrig then return end
	lightOrig = {
		Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime, FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart,
		GlobalShadows = Lighting.GlobalShadows, Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
	}
end
local function restoreLighting(keys)
	if not lightOrig then return end
	for _, k in ipairs(keys) do pcall(function() Lighting[k] = lightOrig[k] end) end
end

local fovOrig
local lastRecord = 0
track(RunService.Heartbeat:Connect(function(dt)
	if not alive then return end
	local h, r = getHum(), getRoot()

	if S.JumpOn and h then
		pcall(function() h.UseJumpPower = true h.JumpPower = S.JumpPower end)
	end
	if S.Bhop and h and UIS:IsKeyDown(Enum.KeyCode.Space) and h.FloorMaterial ~= Enum.Material.Air then
		h:ChangeState(Enum.HumanoidStateType.Jumping)
	end
	if S.AntiVoid and r and h then
		local now = os.clock()
		if h.FloorMaterial ~= Enum.Material.Air and now - lastSafe > 0.5 then
			lastSafe = now
			safePos = r.CFrame + Vector3.new(0, 3, 0)
		end
		if safePos and r.Position.Y < workspace.FallenPartsDestroyHeight + 120 then
			r.AssemblyLinearVelocity = Vector3.zero
			r.CFrame = safePos
		end
	end
	if S.Fullbright then
		Lighting.Brightness = 2
		Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(190, 190, 190)
		Lighting.OutdoorAmbient = Color3.fromRGB(190, 190, 190)
	end
	if S.NoFog then
		Lighting.FogEnd = 1e6
		Lighting.FogStart = 1e6
	end
	if HB.Enabled then
		local now = os.clock()
		if now - lastRecord > 0.25 then
			lastRecord = now
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= LP and plr.Character then
					local rr = plr.Character:FindFirstChild("HumanoidRootPart")
					if rr then
						if not hbOrig[rr] then hbOrig[rr] = { rr.Size, rr.Transparency, rr.CanCollide } end
						pcall(function()
							rr.Size = Vector3.new(HB.Size, HB.Size, HB.Size)
							rr.Transparency = 0.8
