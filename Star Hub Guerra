local sourceCache, loadedCount = {}, 0

local function fetchSource(url)
	local lastErr = "sem resposta"
	for attempt = 1, 3 do
		local ok, res = pcall(function() return game:HttpGet(url, true) end)
		if ok and type(res) == "string" and #res > 0 then return res end
		lastErr = ok and "resposta vazia" or tostring(res)
		local req = (syn and syn.request) or (http and http.request) or http_request or request
		if req then
			local ok2, r = pcall(req, { Url = url, Method = "GET" })
			if ok2 and type(r) == "table" and r.StatusCode == 200 and type(r.Body) == "string" and #r.Body > 0 then
				return r.Body
			end
		end
		task.wait(0.4 * attempt)
	end
	return nil, lastErr
end

local function runFeature(feat, btn)
	if feat.busy then return end
	feat.busy = true
	btn:Set(feat.name, "Carregando…")
	task.spawn(function()
		local src, err = sourceCache[feat.url], nil
		if not src then src, err = fetchSource(feat.url) end
		local ok, msg = false, err
		if src then
			sourceCache[feat.url] = src
			local fn, cerr = loadstring(src)
			if fn then ok, msg = pcall(fn) else msg = cerr end
		end
		feat.busy = false
		if ok then
			if not feat.loaded then feat.loaded = true loadedCount = loadedCount + 1 end
			btn:Set(feat.name, "Carregado ✓  (toque para executar de novo)")
			notify(feat.name, "Executado com sucesso", "Success")
		else
			btn:Set(feat.name, "Falhou — toque para tentar de novo")
			notify(feat.name, tostring(msg):sub(1, 80), "Error", 5)
		end
	end)
end

local function addExternal(tab, list, title)
	tab:AddSection(title or "Scripts externos")
	for _, feat in ipairs(list) do
		local btn
		btn = tab:AddButton({ Name = feat.name, Desc = feat.desc, Callback = function() runFeature(feat, btn) end })
	end
end

