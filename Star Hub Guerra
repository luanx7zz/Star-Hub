----------------------------------------------------------------------
-- Atalhos, status ao vivo e limpeza
----------------------------------------------------------------------
track(UIS.InputBegan:Connect(function(input, gp)
	if not gp and TOGGLE_KEYS[input.KeyCode] then Window:Toggle() end
end))

task.spawn(function()
	local frames, last = 0, os.clock()
	local hb = RunService.Heartbeat:Connect(function() frames = frames + 1 end)
	while alive and Window.Gui.Parent do
		task.wait(1)
		local now = os.clock()
		local fps = math.floor(frames / math.max(now - last, 0.001) + 0.5)
		frames, last = 0, now
		local ping = "--"
		pcall(function() ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()) .. " ms" end)
		fpsLbl.Text, pingLbl.Text = tostring(fps), ping
		activeLbl.Text = tostring(activeCount + loadedCount)

		local since = KA.LastHit > 0 and string.format("%.1fs", os.clock() - KA.LastHit) or "nunca"
		local near = KA.Nearest and string.format("%.0f studs", KA.Nearest) or "—"
		kaPanel:Set(nil, string.format("%s\nEspada: %s (%s)\nInimigo mais perto: %s  •  Alcance: %d\nAlvos: %d  •  Acertos: %d  •  Último: %s\nErros: %d  •  Reinícios do loop: %d\nÚltimo erro: %s",
			KA.Status, KA.ToolName, KA.PartInfo, near, KA.Range, KA.Targets, KA.Hits, since, KA.Errors, KA.Restarts, KA.LastErr))
	end
	hb:Disconnect()
end)

_G.StarHubCleanup = function()
	alive = false
	for _, f in ipairs(Cleanups) do pcall(f) end
	for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
	pcall(function() Window:Destroy() end)
	_G.StarHubCleanup = nil
end

notify("Star Hub " .. VERSION, "Carregado. B ou RightShift mostram/escondem.", "Success", 4)
